release:
  release_date: '2026-11-24'
  text: |
    **For help and a quick start on Thunderbird 153, see
    [Thunderbird 153 Meadow FAQ](https://support.mozilla.org/en-US/kb/new-thunderbird-desktop)**

    **For more on all the new features in Thunderbird 153, see
    [What’s New in Thunderbird 153](https://updates.thunderbird.net/thunderbird/153.0/whatsnew/).**

    **System Requirements:** [Details](/en-US/thunderbird/153.0esr/system-requirements/)

  import_system_requirements: '153.0esr'

notes:
  # Changed
  - note: Thundermail built-in add-on updated to v2.0.30
    tag: changed
    bugs: [2077546]

  # Fixed
  - note: Contact edits by Manifest V3 extensions stored excess data and caused slowdowns
    tag: fixed
    bugs: [2085594]
  - note: Some IMAP messages caused the message pane to reload endlessly
    tag: fixed
    bugs: [2089523]
  - note: '[Security fixes](https://www.mozilla.org/en-US/security/known-vulnerabilities/thunderbird/#thunderbird153.8)'
    tag: fixed
